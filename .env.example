# Copy environment files from the examples below:
#
#   cp backend/.env.example backend/.env
#   cp frontend/.env.local.example frontend/.env.local
#
# See README.md for full variable descriptions.
#
# MCP (optional — set in your shell/OS environment, NOT in this file):
#   CONTEXT7_API_KEY=          # optional; Context7 rate limits
#   GITHUB_TOKEN=              # only if using mcp.github-remote.example.json
#   POSTMAN_API_KEY=           # optional; Postman EU or API-key auth
#   HF_TOKEN=                  # optional; Hugging Face MCP if not using OAuth
#
# See docs/mcp.md for MCP OAuth setup (GitHub, Google Cloud, Sentry, Postman).
