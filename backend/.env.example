# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROMPT_VERSION=v1
# Agent runtime for copilot / research / workflows: auto | adk | legacy
# Requires google-adk from requirements.txt (FastAPI is pinned for ADK/OpenTelemetry compatibility).
AGENT_BACKEND=auto

APP_VERSION=1.0.0
GIT_SHA=local

# Firebase / GCP
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# MedDocs (Vertex ADC + Document AI)
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
VERTEX_LOCATION=us-central1
DOCUMENT_AI_PROCESSOR_ID=
DOCUMENT_AI_LOCATION=us
VERTEX_GEMINI_MODEL=gemini-2.5-flash

# Vertex AI Search (optional)
VERTEX_SEARCH_DATA_STORE_ID=
VERTEX_SEARCH_LOCATION=global
VERTEX_SEARCH_SERVING_CONFIG=default_search

# BigQuery productivity events (optional)
BIGQUERY_DATASET_ID=
BIGQUERY_PRODUCTIVITY_TABLE=productivity_events

# Cloud Healthcare API FHIR export (optional)
HEALTHCARE_DATASET_ID=
HEALTHCARE_FHIR_STORE_ID=
HEALTHCARE_LOCATION=us-central1

# Auth
AUTH_REQUIRED=false

# Uploads
MAX_UPLOAD_SIZE_MB=10

# Server
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
